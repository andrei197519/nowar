{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open site (PHP built-in)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "php-server"
    },
    {
      "name": "Open maintenance.html",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:8080/maintenance.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "php-server"
    }
  ]
}
